{
    "name": "max-messenger-bot/max-bot-api-php",
    "description": "PHP SDK for the Max Messenger Bot API",
    "keywords": [
        "max",
        "messenger",
        "bot",
        "max messenger",
        "max bot",
        "api",
        "sdk",
        "php"
    ],
    "type": "library",
    "license": "MIT",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MaxMessenger\\Bot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MaxMessenger\\Bot\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Eugene Makhaev",
            "email": "mj4444@mail.ru"
        }
    ],
    "support": {
        "email": "mj4444@mail.ru",
        "chat": "https://t.me/mj4444ru"
    },
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "mj4444/simple-http-client": "^0.2"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "nyholm/psr7": "^1.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "vimeo/psalm": "^6.16"
    },
    "suggest": {
        "ext-curl": "To send API requests with the bundled CurlHttpClient; not needed with a PSR-18 client",
        "psr/http-client": "To send API requests with PsrHttpClient through any PSR-18 client",
        "psr/http-factory": "To build PSR-7 requests in PsrHttpClient",
        "psr/http-message": "To handle Webhook requests from a PSR-7 object and to use PsrHttpClient"
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "psalm": "psalm",
        "test": "codecept run"
    },
    "bin": [
        "bin/max-chats",
        "bin/max-debug",
        "bin/max-delete-chats",
        "bin/max-subscribe",
        "bin/max-subscribes",
        "bin/max-unsubscribe",
        "bin/polling-to-webhook"
    ],
    "config": {
        "sort-packages": true
    }
}
